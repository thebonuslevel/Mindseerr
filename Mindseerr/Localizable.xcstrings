    "Letterboxd doesn't let apps sign in, so Mindseerr reads your public watchlist page. It never asks for your password." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Letterboxd no permite que las apps inicien sesión, así que Mindseerr lee tu página pública de lista de seguimiento. Nunca te pide la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Letterboxd ne permet pas aux apps de se connecter ; Mindseerr lit donc la page publique de votre liste de suivi. Elle ne vous demande jamais votre mot de passe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Letterboxd не позволяет приложениям входить в аккаунт, поэтому Mindseerr читает вашу публичную страницу со списком «Хочу посмотреть». Пароль он никогда не запрашивает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Letterboxd 不允许应用登录，因此 Mindseerr 会读取你的公开待看清单页面，不会向你索要密码。"
          }
        }
      }
    },
