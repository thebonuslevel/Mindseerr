    "Opens the movie in Infuse by its TMDB id and starts it. Infuse needs the title in its library." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre la película en Infuse por su id de TMDB y la reproduce. Infuse necesita tener el título en su biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre le film dans Infuse grâce à son identifiant TMDB et le lance. Infuse doit avoir ce titre dans sa bibliothèque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Открывает фильм в Infuse по его TMDB id и запускает воспроизведение. Фильм должен быть в медиатеке Infuse."
          }
        },
        "zh-Hans" : {
