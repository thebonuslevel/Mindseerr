    "Mindseerr only hands the movie over; Infuse has to be installed on this Apple TV and connected to your library." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr solo le pasa la película a Infuse; Infuse debe estar instalada en este Apple TV y conectada a tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr se contente de transmettre le film ; Infuse doit être installé sur cette Apple TV et connecté à votre bibliothèque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr только передаёт фильм: Infuse должен быть установлен на этой Apple TV и подключён к вашей медиатеке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr 只负责把电影交给 Infuse；Infuse 需要已安装在这台 Apple TV 上，并已连接到你的媒体库。"
          }
        }
      }
    },
    "Mindseerr stops showing downloads from %@. Nothing changes on the %@ server." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mindseerr stops showing downloads from %1$@. Nothing changes on the %2$@ server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr dejará de mostrar las descargas de %1$@. No cambia nada en el servidor de %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr n’affichera plus les téléchargements de %1$@. Rien ne change sur le serveur %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr перестанет показывать загрузки из %1$@. На сервере %2$@ ничего не изменится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr 将不再显示来自 %1$@ 的下载。%2$@ 服务器上不会有任何变化。"
