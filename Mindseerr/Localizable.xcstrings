        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inicia sesión en themoviedb.org con tu teléfono u ordenador. Las películas y series de tu lista de seguimiento de TMDB aparecen aquí, y tú eliges qué solicitar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Connectez-vous sur themoviedb.org avec votre téléphone ou votre ordinateur. Les films et séries de votre liste de suivi TMDB apparaissent ici, et vous choisissez ce que vous voulez demander."
          }
        },
        "ru" : {
          "stringUnit" : {
