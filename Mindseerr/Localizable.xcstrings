    "Sections that are off are hidden from Discover. Their titles can still be used for the Top Shelf." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las secciones desactivadas se ocultan en Descubrir. Sus títulos aún se pueden usar en Top Shelf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les sections désactivées sont masquées dans Découvrir. Leurs titres peuvent toujours servir pour le Top Shelf."
