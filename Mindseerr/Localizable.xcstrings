    "%@ couldn't be opened." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pudo abrir %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible d’ouvrir %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось открыть %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法打开 %@。"
          }
        }
      }
    },
    "%@ didn't open. Install it from the App Store on your Apple TV, then try again, or turn the Play button off in Settings → External Player." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no se abrió. Instálala desde la App Store en tu Apple TV y vuelve a intentarlo, o desactiva el botón Reproducir en Ajustes → Reproductor externo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ ne s’est pas ouvert. Installez-le depuis l’App Store sur votre Apple TV, puis réessayez, ou désactivez le bouton Lire dans Réglages → Lecteur externe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ не открылось. Установите приложение из App Store на Apple TV и повторите попытку или отключите кнопку «Смотреть» в разделе «Настройки» → «Внешний плеер»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 未能打开。请先在 Apple TV 的 App Store 中安装，然后重试，或在“设置 → 外部播放器”中关闭播放按钮。"
          }
        }
      }
    },
    "%@ didn't recognize that address. If it uses a URL base (like /%@), include it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn't recognize that address. If it uses a URL base (like /%2$@), include it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ no reconoció esa dirección. Si usa una base de URL (como /%2$@), inclúyela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ n’a pas reconnu cette adresse. Si elle utilise une base d’URL (par exemple /%2$@), ajoutez-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ не распознал этот адрес. Если используется базовый путь URL (например, /%2$@), укажите его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 无法识别该地址。如果使用了 URL 基础路径（如 /%2$@），请一并填写。"
          }
        }
      }
    },
    "%@ didn't recognize that address. Use Transmission's address, like http://192.168.1.10:9091." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no reconoció esa dirección. Usa la dirección de Transmission, como http://192.168.1.10:9091."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a pas reconnu cette adresse. Utilisez l’adresse de Transmission, par exemple http://192.168.1.10:9091."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ не распознал этот адрес. Укажите адрес Transmission, например http://192.168.1.10:9091."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 无法识别该地址。请使用 Transmission 的地址，例如 http://192.168.1.10:9091。"
          }
        }
      }
    },
    "%@ didn't recognize that address. Use the Web UI address, like http://192.168.1.10:8080." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no reconoció esa dirección. Usa la dirección de la Web UI, como http://192.168.1.10:8080."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’a pas reconnu cette adresse. Utilisez l’adresse de la Web UI, par exemple http://192.168.1.10:8080."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ не распознал этот адрес. Укажите адрес Web UI, например http://192.168.1.10:8080."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 无法识别该地址。请使用 Web UI 的地址，例如 http://192.168.1.10:8080。"
          }
        }
      }
    },
    "%@ isn't connected to a Deluge daemon. Open its Web UI and choose one under Connection Manager." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no está conectado a un daemon de Deluge. Abre su Web UI y elige uno en Connection Manager."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ n’est connecté à aucun démon Deluge. Ouvrez sa Web UI et choisissez-en un dans Connection Manager."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ не подключён к демону Deluge. Откройте его Web UI и выберите демон в разделе Connection Manager."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 未连接到 Deluge 守护进程。请打开其 Web UI，在 Connection Manager 中选择一个。"
          }
        }
      }
    },
    "%@ refused the request. Check its RPC whitelist in settings.json." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ rechazó la solicitud. Revisa su lista blanca de RPC en settings.json."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ a refusé la demande. Vérifiez sa liste blanche RPC dans settings.json."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ отклонил запрос. Проверьте белый список RPC в settings.json."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 拒绝了该请求。请检查 settings.json 中的 RPC 白名单。"
          }
        }
      }
    },
    "%@ refused the sign-in. Check the username and password, and that the Web UI is enabled in qBittorrent." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ rechazó el inicio de sesión. Revisa el usuario y la contraseña, y que la Web UI esté activada en qBittorrent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ a refusé la connexion. Vérifiez le nom d’utilisateur et le mot de passe, ainsi que l’activation de la Web UI dans qBittorrent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ отклонил вход. Проверьте имя пользователя и пароль, а также что Web UI включён в qBittorrent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 拒绝了登录。请检查用户名和密码，并确认 qBittorrent 中已启用 Web UI。"
          }
        }
      }
    },
    "%@ rejected the API key. Copy it again from Config → General in SABnzbd." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rechazó la clave de API. Vuelve a copiarla desde Config → General en SABnzbd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a rejeté la clé API. Copiez-la à nouveau depuis Config → General dans SABnzbd."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отклонил ключ API. Скопируйте его заново в SABnzbd: Config → General."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了该 API 密钥。请在 SABnzbd 的 Config → General 中重新复制。"
          }
        }
      }
    },
    "%@ rejected the API key. Copy it again from Settings → General in %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ rejected the API key. Copy it again from Settings → General in %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ rechazó la clave de API. Vuelve a copiarla desde Ajustes → General en %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ a rejeté la clé API. Copiez-la à nouveau depuis Réglages → Général dans %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ отклонил ключ API. Скопируйте его заново в разделе «Настройки» → «Основные» в %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 拒绝了该 API 密钥。请在 %2$@ 的“设置 → 通用”中重新复制。"
          }
        }
      }
    },
    "%@ rejected the password. It's the one for Deluge's Web UI (the default is “deluge”)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ rechazó la contraseña. Es la de la Web UI de Deluge (por defecto es «deluge»)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ a rejeté le mot de passe. Il s’agit de celui de la Web UI de Deluge (par défaut : « deluge »)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ отклонил пароль. Нужен пароль от Web UI Deluge (по умолчанию «deluge»)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 拒绝了该密码。这里需要填写 Deluge Web UI 的密码（默认为“deluge”）。"
          }
        }
      }
    },
