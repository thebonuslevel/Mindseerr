    "%@ sent a response the app didn't understand. Is that a %@ server?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ sent a response the app didn't understand. Is that a %2$@ server?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ envió una respuesta que la app no entendió. ¿Es un servidor de %2$@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ a envoyé une réponse que l’app n’a pas comprise. Est-ce bien un serveur %2$@ ?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ прислал ответ, который приложение не поняло. Это точно сервер %2$@?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 发送了应用无法理解的响应。它是 %2$@ 服务器吗？"
          }
        }
      }
    },
    "%@ sent a response the app didn't understand. Is that a qBittorrent server?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ envió una respuesta que la app no entendió. ¿Es un servidor de qBittorrent?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ a envoyé une réponse que l’app n’a pas comprise. Est-ce bien un serveur qBittorrent ?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ прислал ответ, который приложение не поняло. Это точно сервер qBittorrent?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ 发送了应用无法理解的响应。它是 qBittorrent 服务器吗？"
          }
        }
      }
    },
    "%@ signed us out. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ cerró la sesión. Vuelve a intentarlo."
