    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mindseerr connects to your media request server on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr se conecta a tu servidor de solicitudes de contenido en tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr se connecte à votre serveur de demandes de médias sur votre réseau local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr подключается к серверу запросов медиа в вашей локальной сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mindseerr 会连接到你本地网络中的媒体请求服务器。"
